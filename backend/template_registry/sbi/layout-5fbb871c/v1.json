  "header_rules": [
    {
      "kind": "regex",
      "targets": [
        "header.account_number"
      ],
      "pages": [
        1,
        2
      ],
      "pattern": "(?:Account|A/c|Acct)\\.?\\s*(?:Number|No)\\.?\\s*:?\\s*([0-9X*]{6,20})\\b",
      "flags": "i"
    },
    {
      "kind": "regex",
      "targets": [
        "header.ifsc"
      ],
      "pages": [
        1,
        2
      ],
      "pattern": "(?i:\\bIFS(?:C)?(?:\\s*Code)?)\\s*:?\\s*([A-Z]{4}0[A-Z0-9]{6})\\b"
    },
    {
      "kind": "regex",
      "targets": [
        "header.period_start",
        "header.period_end"
      ],
      "pages": [
        1,
        2
      ],
      "pattern": "(?:Statement\\s+)?(?:from|period)\\s*:?\\s*(\\d{1,2}[-/ .](?:\\d{1,2}|[A-Za-z]{3,9})[-/ .]\\d{2,4})\\s*(?:to|-)\\s*:?\\s*(\\d{1,2}[-/ .](?:\\d{1,2}|[A-Za-z]{3,9})[-/ .]\\d{2,4})",
      "flags": "i"
    },
    {
      "kind": "regex",
      "targets": [
        "header.account_holder_name"
      ],
      "pages": [
        1,
        2
      ],
      "pattern": "(?:Account\\s+Name|Customer\\s+Name)\\s*:\\s*(.+?)\\s*$",
      "flags": "im"
    },
    {
      "kind": "regex",
      "targets": [
        "header.account_holder_address"
      ],
      "pages": [
        1
      ],
      "pattern": "Account\\s+Name\\s*:.*\\nAddress\\s*:\\s*(.+?)\\n(?:Date|Account\\s+Number)\\s*:",
      "flags": "is"
    },
    {
      "kind": "regex",
      "targets": [
        "header.branch"
      ],
      "pages": [
        1,
        2
      ],
      "pattern": "(?:Branch[ \\t]+Name|Home[ \\t]+Branch|Account[ \\t]+Branch|Branch)[ \\t]*:[ \\t]*([A-Z][A-Za-z0-9 .&-]*?)[ \\t]*(?=[ \\t][A-Z][A-Za-z.]*(?:[ \\t][A-Za-z.]+)*[ \\t]*:|$)",
      "flags": "m"
    },
    {
      "kind": "regex",
      "targets": [
        "header.opening_balance"
      ],
      "pages": [
        1,
        2
      ],
      "pattern": "(?:Opening\\s+Balance|Balance\\s+as\\s+on[^:\\n]*|Brought\\s+Forward)\\s*:?\\s*(-?[\\d,]+\\.\\d{2}(?:\\s?(?:CR|DR|Cr|Dr))?)",
      "flags": "i"
    }
  ],
