  "cards": [
    {
      "dot": "emerald",
      "title": "Workflow 1",
      "items": [
        "Runs immediately for every document",
        "Known layout: template; unknown: inferred layout",
        "Result is marked EXTRACTED only if arithmetic verifies",
        "The app polls the stored status and result"
      ]
    },
    {
      "dot": "violet",
      "title": "Workflow 2",
      "items": [
        "Separate process pool; extraction never waits",
        "≤3 candidates, ≤2 refinements, 300 s, no LLM",
        "Accepted → document re-extracted with the new template"
      ]
    }
