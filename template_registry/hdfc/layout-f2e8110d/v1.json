  "header_rules": [
    {
      "kind": "regex",
      "targets": [
        "header.account_number"
      ],
      "pages": [
        1,
        2
      ],
      "pattern": "(?:Account|A/c|Acct)\\.?\\s*(?:Number|No)\\.?\\s*:?\\s*([0-9X*]{6,20})\\b",
      "flags": "i"
    },
    {
      "kind": "regex",
      "targets": [
        "header.ifsc"
      ],
      "pages": [
        1,
        2
      ],
      "pattern": "(?i:\\bIFS(?:C)?(?:\\s*Code)?)\\s*:?\\s*([A-Z]{4}0[A-Z0-9]{6})\\b"
    },
    {
      "kind": "regex",
      "targets": [
        "header.period_start",
        "header.period_end"
      ],
      "pages": [
        1,
        2
      ],
      "pattern": "(?:Statement\\s+)?(?:from|period)\\s*:?\\s*(\\d{1,2}[-/ .](?:\\d{1,2}|[A-Za-z]{3,9})[-/ .]\\d{2,4})\\s*(?:to|-)\\s*:?\\s*(\\d{1,2}[-/ .](?:\\d{1,2}|[A-Za-z]{3,9})[-/ .]\\d{2,4})",
      "flags": "i"
    },
    {
      "kind": "regex",
      "targets": [
        "header.account_holder_name"
      ],
      "pages": [
        1
      ],
      "pattern": "^((?:Mr|Mrs|Ms|Miss|Dr|M/s)\\.?[ \\t]+[A-Za-z][A-Za-z.' \\t]*?)(?=[ \\t]+(?:[A-Za-z]+[ \\t]+){0,2}[A-Za-z]+[ \\t]*:|[ \\t]*$)",
      "flags": "im"
    },
    {
      "kind": "regex",
      "targets": [
        "header.branch"
      ],
      "pages": [
        1,
        2
      ],
      "pattern": "(?:Branch[ \\t]+Name|Home[ \\t]+Branch|Account[ \\t]+Branch|Branch)[ \\t]*:[ \\t]*([A-Z][A-Za-z0-9 .&-]*?)[ \\t]*(?=[ \\t][A-Z][A-Za-z.]*(?:[ \\t][A-Za-z.]+)*[ \\t]*:|$)",
      "flags": "m"
    },
    {
      "kind": "regex",
      "targets": [
        "header.currency"
      ],
      "pages": [
        1,
        2
      ],
      "pattern": "\\bCurrency\\s*:\\s*([A-Z]{3})\\b"
    }
  ],
